# ==============================================================================
# AUDIBLE AI — EXOTEL BIDIRECTIONAL TELEPHONY CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.exotel or export these environment variables before
# launching live carrier testing.
# NEVER commit your actual API token or secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EXOTEL CARRIER CREDENTIALS (from my.exotel.com -> Settings -> API Keys)
# ------------------------------------------------------------------------------
EXOTEL_ACCOUNT_SID="your_account_sid_here"
EXOTEL_API_KEY="your_api_key_here"
EXOTEL_API_TOKEN="your_api_token_here"

# Base URL:
# For India cluster use: https://api.in.exotel.com
# For international use: https://api.exotel.com
EXOTEL_API_BASE_URL="https://api.in.exotel.com"

# The assigned ExoPhone virtual DID in E.164 (e.g., +91804719XXXX)
EXOTEL_CALLER_ID="+9180XXXXXXXX"

# ------------------------------------------------------------------------------
# 2. PUBLIC INGRESS ENDPOINTS (Requires valid SSL / TLS for Webhooks & WSS)
# ------------------------------------------------------------------------------
# HTTPS public domain pointing to Audible AI backend port 8000/8008
BACKEND_BASE_URL="https://your-public-subdomain.ngrok-free.app"

# WSS public domain for the live media stream
BACKEND_WSS_URL="wss://your-public-subdomain.ngrok-free.app"

# Secret token used to sign and authenticate Exotel Media WebSocket URLs
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TELEPHONY_WS_TOKEN_SECRET="generate_random_32_character_hex_secret_here"

# ------------------------------------------------------------------------------
# 3. AI PIPELINE CONFIGURATION
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:1b"
KOKORO_MODEL_PATH="models/kokoro/kokoro-v0_19.onnx"
KOKORO_VOICES_PATH="models/kokoro/voices.bin"
KOKORO_DEFAULT_VOICE="af_bella"
